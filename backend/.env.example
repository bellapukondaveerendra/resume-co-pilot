ANTHROPIC_API_KEY=your_anthropic_key
JWT_SECRET=a_long_random_secret_min_32_chars
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001
# Production: set to your actual frontend domain, e.g. https://resumecopilot.in
APP_URL=http://localhost:5173
# Resend (transactional email — password reset). Sender domain must be verified.
RESEND_API_KEY=re_...
# Sender address. Must be on a domain you've verified in Resend's Domains tab.
# Default in code is support@resumecopilot.in — override here if you use a different sender.
RESEND_FROM=Resume CoPilot <support@resumecopilot.in>
# Maximum free analyses per guest IP before they must sign up. Default: 10.
GUEST_LIMIT=10
# Opt-in: when true, runs a monthly cron (00:00 UTC, 1st of month) that tops
# up any user with < 2 credits to 2. Only enable on ONE backend instance to
# avoid duplicate runs.
ENABLE_MONTHLY_REFILL=false

# App mode. "F" = free (no credit gating, no pricing UI on the frontend).
# Anything else (or unset) = paid (default). Use F during the pre-boarding
# window while you're waiting for Stripe approval; flip back when ready.
APP_MODE=P

# Kill switch for the Anthropic API. Set to "false" the moment your Anthropic
# balance is depleted / rate-limited — backend will return AI_UNAVAILABLE
# immediately so users see a friendly modal instead of long timeouts.
# Flip back to "true" after topping up. Default: true.
ANTHROPIC_ENABLED=true
